# Copy this to .env for local development. In Render, set these under
# your service's Environment tab instead — do not commit real values.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appname>
MONGO_DB_NAME=lineup

# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

PORT=3000

# Used only by npm run seed:admin to create the first admin (employee) account.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional: override the DNS servers Node uses to resolve the mongodb+srv://
# SRV record, comma-separated. Leave unset to use the built-in defaults
# (Google + Cloudflare). Not usually needed on Render, only on networks/
# machines where Node's resolver disagrees with the OS resolver.
# DNS_SERVERS=8.8.8.8,1.1.1.1
